{
  "manifest_version": 3,
  "name": "JobShield – Job Scam Detector",
  "version": "1.0.0",
  "description": "Detects fake and scam job postings on LinkedIn, Indeed, and Seek using heuristics + AI.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://www.indeed.com/*",
    "https://indeed.com/*",
    "https://www.seek.com.au/*",
    "https://seek.com.au/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://linkedin.com/jobs/*"
      ],
      "js": ["content/extractors/linkedin.js", "content/overlay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.indeed.com/viewjob*",
        "https://www.indeed.com/jobs*",
        "https://indeed.com/viewjob*"
      ],
      "js": ["content/extractors/indeed.js", "content/overlay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.seek.com.au/job/*",
        "https://seek.com.au/job/*"
      ],
      "js": ["content/extractors/seek.js", "content/overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
